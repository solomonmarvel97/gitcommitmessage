{
  "name": "@solomonmarvel97/gitcommitmessage",
  "version": "0.4.0",
  "description": "Write git commit messages with Gemini, Anthropic, OpenAI, xAI, Groq or OpenRouter",
  "keywords": [
    "git",
    "commit",
    "commit-message",
    "conventional-commits",
    "ai",
    "cli",
    "gemini",
    "anthropic",
    "claude",
    "openai",
    "grok",
    "xai",
    "groq",
    "openrouter",
    "developer-tools"
  ],
  "author": "Marvelous Solomon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solomonmarvel97/gitcommitmessage.git"
  },
  "bugs": {
    "url": "https://github.com/solomonmarvel97/gitcommitmessage/issues"
  },
  "homepage": "https://solomonmarvel.com/gitcommitmessage",
  "bin": {
    "gcm": "dist/bin/gcm.js",
    "gitcommitmessage": "dist/bin/gcm.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint bin lib --ext .ts",
    "type-check": "tsc --noEmit",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run type-check && npm run lint && npm test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pretest": "npm run build",
    "pretest:coverage": "npm run build"
  },
  "type": "commonjs",
  "main": "dist/bin/gcm.js",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.30",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/helpers/temp-home.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/"
    ],
    "collectCoverageFrom": [
      "dist/bin/**/*.js",
      "dist/lib/**/*.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
